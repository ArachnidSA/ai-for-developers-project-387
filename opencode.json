{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "protocol": "auto",
        "headers": {
          "Authorization": "Bearer {file:./render-api-key}"
        }
      }
    }
  },
  "agents": {
    "audit": {
      "description": "Аудит Lighthouse: читает отчёт и открывает issue только по новой находке",
      "mode": "primary",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "audit-summary.md", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "gh issue *", "effect": "allow" },
        { "action": "shell", "resource": "gh search *", "effect": "allow" }
      ]
    }
  }
}
