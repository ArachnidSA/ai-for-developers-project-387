{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "protocol": "auto",
        "headers": {
          "Authorization": "Bearer {file:./render-api-key}"
        }
      }
    }
  },
  "agent": {
    "audit": {
      "description": "Аудит Lighthouse: читает отчёт и открывает issue только по новой находке",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "audit-summary.md": "allow"
        },
        "bash": {
          "*": "deny",
          "gh issue *": "allow",
          "gh search *": "allow"
        }
      }
    }
  }
}
