{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "provod": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "provod.ai",
      "options": {
        "baseURL": "https://api.provod.ai/v1",
        "apiKey": "{env:PROVOD_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": { "context": 1048576, "output": 943718 },
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  }
}
