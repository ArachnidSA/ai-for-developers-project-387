{
  "openapi": "3.0.0",
  "info": {
    "title": "Calendar API",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/api/bookings": {
      "post": {
        "operationId": "CalendarApi_createBooking",
        "description": "Создать запись гостем. `end` вычисляется сервером как `start + duration_minutes` типа.\nНеизвестный или архивный тип — 404; время вне рабочих часов или окна записи — 400;\nпересечение с любой существующей записью (в т.ч. другого типа) — 409.\n`422` (некорректные поля тела) отдаёт валидация FastAPI и в контракт не входит.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "The server could not understand the request due to invalid syntax.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state of the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingCreate"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "CalendarApi_listUpcomingBookings",
        "description": "Предстоящие записи всех типов (в том числе архивных) для владельца.\nПрошедшие записи не попадают в список; порядок — по возрастанию начала.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UpcomingBooking"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}": {
      "delete": {
        "operationId": "CalendarApi_deleteBooking",
        "description": "Удалить запись, освободив её слот. Несуществующая запись — 404.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Идентификатор записи.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "There is no content to send for this request, but the headers may be useful. "
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/event-types": {
      "get": {
        "operationId": "CalendarApi_listEventTypes",
        "description": "Список типов событий. По умолчанию — только действующие (гостевой список);\nс `include_archived=true` владелец видит и архивные типы.",
        "parameters": [
          {
            "name": "include_archived",
            "in": "query",
            "required": false,
            "description": "Включать архивные типы (для владельца).",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventType"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "CalendarApi_createEventType",
        "description": "Создать тип события.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventType"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventTypeCreate"
              }
            }
          }
        }
      }
    },
    "/api/event-types/{event_type_id}": {
      "patch": {
        "operationId": "CalendarApi_updateEventType",
        "description": "Изменить тип события. Переданные поля обновляются, остальные не трогаются.",
        "parameters": [
          {
            "name": "event_type_id",
            "in": "path",
            "required": true,
            "description": "Идентификатор типа события.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventType"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventTypeUpdate"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "CalendarApi_deleteEventType",
        "description": "Удалить тип события без записей. Если по типу уже есть записи — 409,\nисторию не теряем, вместо удаления предлагается архивация.",
        "parameters": [
          {
            "name": "event_type_id",
            "in": "path",
            "required": true,
            "description": "Идентификатор типа события.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "There is no content to send for this request, but the headers may be useful. "
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state of the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/event-types/{event_type_id}/archive": {
      "post": {
        "operationId": "CalendarApi_archiveEventType",
        "description": "Архивировать тип события: скрывается от гостей, записи по нему сохраняются.",
        "parameters": [
          {
            "name": "event_type_id",
            "in": "path",
            "required": true,
            "description": "Идентификатор типа события.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventType"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/event-types/{event_type_id}/slots": {
      "get": {
        "operationId": "CalendarApi_listEventTypeSlots",
        "description": "Свободные слоты типа события на календарный день в поясе владельца.\nСлоты идут встык с шагом, равным длительности типа, и не выходят за рабочие часы 09:00–21:00.\nНеизвестный или архивный тип — 404; дата вне окна записи (14 дней от «сегодня») — 400.\n`422` (некорректный формат даты) отдаёт валидация FastAPI и в контракт не входит.",
        "parameters": [
          {
            "name": "event_type_id",
            "in": "path",
            "required": true,
            "description": "Идентификатор типа события.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Календарный день в поясе владельца (YYYY-MM-DD).",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Slot"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The server could not understand the request due to invalid syntax.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Понятное человеку описание ошибки."
          }
        },
        "description": "Тело ответа об ошибке."
      },
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "event_type_id",
          "guest_name",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Системный идентификатор."
          },
          "event_type_id": {
            "type": "integer",
            "format": "int32",
            "description": "Тип события, на который записался гость."
          },
          "guest_name": {
            "type": "string",
            "description": "Имя гостя."
          },
          "guest_email": {
            "type": "string",
            "description": "Email гостя. Поле отсутствует, если гость его не указал (сервер не шлёт `null`)."
          },
          "note": {
            "type": "string",
            "description": "Заметка гостя. Поле отсутствует, если гость её не оставил (сервер не шлёт `null`)."
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало встречи в UTC (ISO 8601)."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "Конец встречи в UTC (ISO 8601). Вычисляется сервером."
          }
        },
        "description": "Запись гостя на выбранный слот."
      },
      "BookingCreate": {
        "type": "object",
        "required": [
          "event_type_id",
          "start",
          "guest_name"
        ],
        "properties": {
          "event_type_id": {
            "type": "integer",
            "format": "int32",
            "description": "Тип события, на который записывается гость."
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало встречи в UTC (ISO 8601); должно попадать в свободный слот."
          },
          "guest_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Имя гостя (1–100 символов, обязательно)."
          },
          "guest_email": {
            "type": "string",
            "format": "email",
            "description": "Email гостя (необязательно, проверяется формат)."
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "description": "Заметка гостя (необязательно, до 500 символов)."
          }
        },
        "description": "Данные для создания записи гостем."
      },
      "EventType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "duration_minutes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Системный идентификатор."
          },
          "name": {
            "type": "string",
            "description": "Название типа события."
          },
          "description": {
            "type": "string",
            "description": "Описание типа события."
          },
          "duration_minutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 720,
            "description": "Длительность встречи в минутах (5–720)."
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EventTypeStatus"
              }
            ],
            "description": "Статус типа события."
          }
        },
        "description": "Вид встречи, который заводит владелец."
      },
      "EventTypeCreate": {
        "type": "object",
        "required": [
          "name",
          "description",
          "duration_minutes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Название типа события."
          },
          "description": {
            "type": "string",
            "description": "Описание типа события."
          },
          "duration_minutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 720,
            "description": "Длительность встречи в минутах (5–720)."
          }
        },
        "description": "Данные для создания типа события."
      },
      "EventTypeStatus": {
        "type": "string",
        "enum": [
          "active",
          "archived"
        ],
        "description": "Статус типа события: действующий или архивный."
      },
      "EventTypeUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Название типа события."
          },
          "description": {
            "type": "string",
            "description": "Описание типа события."
          },
          "duration_minutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 720,
            "description": "Длительность встречи в минутах (5–720). Не двигает уже сделанные записи."
          }
        },
        "description": "Данные для изменения типа события: переданные поля обновляются, остальные не трогаются."
      },
      "Slot": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало слота в UTC (ISO 8601)."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "Конец слота в UTC (ISO 8601)."
          }
        },
        "description": "Свободный слот: полуинтервал `[start, end)` времени в UTC."
      },
      "UpcomingBooking": {
        "type": "object",
        "required": [
          "id",
          "event_type_id",
          "event_type_name",
          "guest_name",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Системный идентификатор."
          },
          "event_type_id": {
            "type": "integer",
            "format": "int32",
            "description": "Тип события, на который записался гость."
          },
          "event_type_name": {
            "type": "string",
            "description": "Название типа события."
          },
          "guest_name": {
            "type": "string",
            "description": "Имя гостя."
          },
          "guest_email": {
            "type": "string",
            "description": "Email гостя. Поле отсутствует, если гость его не указал (сервер не шлёт `null`)."
          },
          "note": {
            "type": "string",
            "description": "Заметка гостя. Поле отсутствует, если гость её не оставил (сервер не шлёт `null`)."
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало встречи в UTC (ISO 8601)."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "Конец встречи в UTC (ISO 8601)."
          }
        },
        "description": "Предстоящая запись в списке владельца: время, тип, имя, email и заметка гостя."
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Локальный сервер разработки",
      "variables": {}
    }
  ]
}
